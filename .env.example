# Municipal Water Utility Geo Settings (Mumbai Metropolitan Water Grid - BMC)
CITY_NAME="Mumbai Metropolitan Water Grid (BMC)"
CITY_CENTER_LAT=19.0760
CITY_CENTER_LNG=72.8777

# Google Maps API Configuration
# (Optional: If left empty, the frontend renders high-resolution live Google Maps tiles without requiring an API key)
VITE_GOOGLE_MAPS_API_KEY=""

# ML Model Detection & Debounce Rules
CONFIDENCE_ALERT_THRESHOLD=0.85
CONSECUTIVE_LEAKS_THRESHOLD=2

# Database
DATABASE_URL="sqlite:///./water_leak.db"

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

